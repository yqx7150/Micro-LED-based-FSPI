data:
  category: SIAT
  centered: false
  dataset: LSUN
  image_size: 128
  num_channels: 1
  random_flip: true
  uniform_dequantization: false
device: !!python/object/apply:torch.device
- cuda
- 0
eval:
  batch_size: 1
  begin_ckpt: 1
  bpd_dataset: test
  enable_bpd: false
  enable_loss: true
  enable_sampling: true
  end_ckpt: 100
  num_samples: 1000
model:
  attention_type: ddpm
  attn_resolutions: !!python/tuple
  - 16
  beta_max: 20.0
  beta_min: 0.1
  ch_mult: !!python/tuple
  - 1
  - 1
  - 2
  - 2
  - 2
  - 2
  - 2
  conditional: true
  conv_size: 3
  dropout: 0.0
  ema_rate: 0.999
  embedding_type: fourier
  fir: true
  fir_kernel:
  - 1
  - 3
  - 3
  - 1
  fourier_scale: 16
  init_scale: 0.0
  name: ncsnpp
  nf: 64
  nonlinearity: swish
  normalization: GroupNorm
  num_res_blocks: 2
  num_scales: 2000
  progressive: output_skip
  progressive_combine: sum
  progressive_input: input_skip
  resamp_with_conv: true
  resblock_type: biggan
  scale_by_sigma: true
  sigma_max: 378
  sigma_min: 0.01
  skip_rescale: true
optim:
  beta1: 0.9
  eps: 1.0e-08
  grad_clip: 1.0
  lr: 0.0001
  optimizer: Adam
  warmup: 5000
  weight_decay: 0
sampling:
  corrector: langevin
  method: pc
  n_steps_each: 1
  noise_removal: true
  predictor: reverse_diffusion
  probability_flow: false
  snr: 0.075
seed: 42
training:
  batch_size: 12
  continuous: true
  eval_freq: 100
  likelihood_weighting: false
  log_freq: 100
  n_iters: 300001
  reduce_mean: false
  sde: vesde
  snapshot_freq: 10000
  snapshot_freq_for_preemption: 20000
  snapshot_sampling: true

